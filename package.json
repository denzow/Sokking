{
  "name": "sokking",
  "version": "0.1.0",
  "description": "Task box + Claude Code runner for Ubuntu",
  "main": "./out/main/index.js",
  "license": "MIT",
  "author": "denzow",
  "scripts": {
    "dev": "electron-vite dev -- --no-sandbox",
    "build": "electron-vite build",
    "start": "electron-vite preview -- --no-sandbox",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "postinstall": "electron-builder install-app-deps",
    "package": "electron-vite build && electron-builder --linux",
    "install-desktop": "scripts/install-desktop.sh",
    "install-autostart": "scripts/install-autostart.sh",
    "test": "vitest run"
  },
  "build": {
    "appId": "dev.denzow.sokking",
    "productName": "sokking",
    "files": [
      "out/**",
      "resources/**"
    ],
    "extraResources": [
      {
        "from": "resources/sokking-hook.js",
        "to": "sokking-hook.js"
      }
    ],
    "linux": {
      "target": "AppImage",
      "category": "TerminalEmulator",
      "icon": "resources/icon.png"
    }
  },
  "dependencies": {
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "croner": "^9.1.0",
    "node-pty": "^1.1.0",
    "simple-git": "^3.36.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "material-icon-theme": "^5.36.1",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.12",
    "zustand": "^5.0.14"
  },
  "bin": {
    "sokking": "./bin/sokking.js"
  }
}
